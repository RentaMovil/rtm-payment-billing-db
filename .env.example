# Copy to .env (never commit .env). Used by docker-compose.yml.
# This repo does NOT start SQL Server: rtm-iam-db owns the shared rentamovil instance, so the
# values below only match what that repo already uses.
# SA password must meet SQL Server complexity rules: 8+ chars, upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=ChangeMe_Local123!
MSSQL_PORT=1433
MSSQL_DATABASE=rentamovil

# Password for the payment_app user, used by the "migrations" container (03_dcl).
# Must be the same value as parameter.paymentAppPassword in liquibase.properties
# and DATABASE_PASSWORD in rtm-payment-billing/.env
PAYMENT_APP_PASSWORD=ChangeMe_PaymentApp123!
